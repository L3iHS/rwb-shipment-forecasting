{
	admin off
	auto_https off
	persist_config off
	servers {
		trusted_proxies static private_ranges
		trusted_proxies_strict
	}
}

:8080 {
	root * /srv
	encode zstd gzip

	@api path /api /api/*
	@assets path /assets /assets/*
	@existing_asset {
		path /assets/*
		file {path}
	}
	@static path_regexp static (?i)\.(html|js|mjs|css|map|json|csv|png|jpe?g|gif|svg|ico|webp|avif|woff2?|ttf|webmanifest)$

	route {
		handle /healthz {
			respond "ok" 200
		}

		handle @api {
			reverse_proxy api:8000 {
				header_up X-Forwarded-For {client_ip}
				transport http {
					read_timeout 70s
				}
			}
		}

		handle /board.json {
			header Cache-Control "no-cache"
			file_server
		}

		handle @existing_asset {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		handle @assets {
			respond "Not found" 404
		}

		handle @static {
			header Cache-Control "no-cache"
			file_server
		}

		handle {
			try_files {path} /index.html
			header Cache-Control "no-cache"
			file_server
		}
	}
}
