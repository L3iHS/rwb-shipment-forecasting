.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.DS_Store
.env
.env.*
!.env.example
.local/
/AGENTS.md
.pytest_cache/
.coverage
htmlcov/

# Generated features, models and submissions stay local. In Git: the service bundle and the validation-week
# forecasts that the app's numbers come from (scripts/pipeline.py export reads them).
data/processed/*
!data/processed/.gitkeep
models/*
!models/.gitkeep
!models/prod/
!models/rolling/
models/rolling/*
!models/rolling/lean_fold0.npz
!models/rolling/lean_fold1.npz
submissions/*
!submissions/.gitkeep
!submissions/README.md

# Participant experiment environments and generated outputs.
.venv-ag/
.venv-exp/
venv/
env/
*.egg-info/
.mypy_cache/
.ruff_cache/
catboost_info/
lightning_logs/
mlruns/
experiments/preds/
.claude/*
!.claude/CLAUDE.md

# Service outputs are regenerated by scripts/pipeline.py.
outputs/*

# Kept locally, not in Git: notebooks, the organizers' reference files, old design notes.
notebooks/
data/reference/
docs/ideas/

# Local tools: IDE, personal launch scripts (Claude Code settings are above).
.idea/
*.sh
!/deploy/update.sh
!/deploy/main-release.sh
!/deploy/ssh-entry.sh
